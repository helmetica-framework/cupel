{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":gitSignOff",
    "helpers:pinGitHubActionDigests"
  ],
  "labels": [
    "dependency"
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "packageRules": [
    {
      "groupName": "charmbracelet",
      "description": "Group the Charm TUI stack (bubbletea/bubbles/lipgloss, both github.com and charm.land module paths) so their coordinated v2-style releases upgrade together in a single PR instead of a broken partial bump.",
      "matchPackageNames": [
        "/^github\\.com/charmbracelet//",
        "/^charm\\.land//"
      ]
    },
    {
      "schedule": [
        "on the first day of the month"
      ],
      "automerge": true,
      "matchPackageNames": [
        "/k8s.io/utils/",
        "/golang.org/x/exp/",
        "/sigs.k8s.io/controller-runtime/tools/setup-envtest/"
      ]
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions dependencies",
      "minimumReleaseAge": "7 days",
      "prCreation": "not-pending",
      "internalChecksFilter": "strict"
    }
  ]
}
